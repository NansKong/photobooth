# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Redis Configuration (Optional - falls back to fast in-memory store if unset)
# REDIS_URL=redis://localhost:6379

# Optional TURN relay credentials (server-side only)
METERED_DOMAIN=your-app.metered.live
METERED_API_KEY=your-metered-api-key
# Or use a static TURN server instead:
# TURN_URL=turn:relay.example.com:443
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-credential
