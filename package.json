{
  "name": "virtual-photobooth",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build:shared && concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev --workspace=@photobooth/server",
    "dev:web": "npm run dev --workspace=@photobooth/web",
    "build:shared": "npm run build --workspace=@photobooth/shared",
    "build:server": "npm run build --workspace=@photobooth/server",
    "build:web": "npm run build --workspace=@photobooth/web",
    "build": "npm run build:shared && npm run build:server && npm run build:web",
    "vercel-build": "npm run build:shared && npm run build:web",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run start --workspace=@photobooth/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
