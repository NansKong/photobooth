# =============================================================================
# Gitignore for Virtual Photobooth (Next.js + Express + TypeScript Monorepo)
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Next.js & TypeScript Build Outputs
.next/
out/
build/
dist/
*.tsbuildinfo

# Cache directories
.cache/
.turbo/
.parcel-cache/
.eslintcache
.stylelintcache

# Environment Variables & Secrets
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local
# Preserve example templates
!.env.example
!.env.*.example

# Testing & Coverage
coverage/
.nyc_output/
*.lcov

# Debug Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Editor & IDE Directories
.idea/
.fleet/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Temporary / Scratch files
*.tmp
*.temp
*~

.vercel
